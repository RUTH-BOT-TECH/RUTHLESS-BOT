BOT_NAME=Ruthless
# Optional menu tagline; defaults to BOT_NAME.
BOT_TAGLINE=
STICKER_PACK=Ruthless
STICKER_AUTHOR=Ruthless MD
PREFIX=.
MODE=public
# International digits only, without +.
OWNER_NUMBER=
# Number of the WhatsApp account being linked (may differ from OWNER_NUMBER).
PAIRING_NUMBER=
# Shared deployment: trusted data service URL and tenant-scoped token.
DATA_SERVICE_URL=
DATA_SERVICE_TOKEN=
# Direct MongoDB is for a single trusted deployer only; never share its credential.
DATABASE_URL=
# Deprecated legacy compatibility switch; DATABASE_URL must be a private, isolated database.
ALLOW_LEGACY_DIRECT_MONGO=false
# A short pairing-service ID, or the legacy snapshot. Treat as a password.
SESSION_ID=
PAIRING_SITE_URL=
PAIRING_API_URL=
HEARTBEAT=off
# Optional GitHub repository, e.g. https://github.com/name/repository
REPO_URL=https://github.com/RUTH-BOT-TECH/RUTHLESS-BOT
DONATE_URL=
SUPPORT_TEXT=Contact the bot owner for support.
RULES_TEXT=Be respectful and follow group rules.
FAQ_TEXT=Use .menu to see available commands.
TOS_TEXT=Use this bot responsibly.
PRIVACY_TEXT=This bot stores settings and account data configured by its owner.
DEFAULT_TIMEZONE=Africa/Lagos
DEPLOY_HOOK=
PORT=3000
# Python containing the pinned yt-dlp and gallery-dl; see README.
PYTHON_BIN=.venv/bin/python
